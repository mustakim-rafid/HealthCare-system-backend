# ---- Server ----
NODE_ENV=development
PORT=5000
# Frontend origin(s) allowed by CORS and used in emails / Stripe redirects (comma separated, first one is primary)
CLIENT_URL=http://localhost:3000

# ---- Database ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/health-care-db?schema=public"

# ---- Auth ----
BCRYPT_SALT_ROUND=10
ACCESS_TOKEN_SECRET=change-me-access-secret
ACCESS_TOKEN_EXPIRY=1h
REFRESH_TOKEN_SECRET=change-me-refresh-secret
REFRESH_TOKEN_EXPIRY=10d

# ---- Super admin (created once on startup / by `npm run seed`; never overwritten afterwards) ----
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ---- Demo data for `npm run seed` (development/testing) ----
SEED_DEMO_DATA=true
DEMO_DOCTOR_EMAIL=doctor@healthcare.dev
DEMO_DOCTOR_PASSWORD=Doctor@12345
DEMO_PATIENT_EMAIL=patient@healthcare.dev
DEMO_PATIENT_PASSWORD=Patient@12345

# ---- Booking policy ----
# Unpaid slot hold (Stripe requires >= 30)
SLOT_HOLD_MINUTES=30
# Patients can cancel a paid booking (full refund) until this many hours before start
CANCELLATION_CUTOFF_HOURS=24
REMINDER_MINUTES_BEFORE=10
# Set to true to disable the in-process scheduler (e.g. on a secondary instance)
DISABLE_JOBS=false

# ---- Payments (Stripe test keys for development) ----
STRIPE_SECRET_KEY=sk_test_xxx
# Optional but recommended: webhook endpoint = <API_URL>/api/v1/payment/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxx
PAYMENT_CURRENCY=bdt

# ---- Time ----
# Timezone admins enter slot times in, and used in notifications/emails (IANA name)
APP_TIMEZONE=Asia/Dhaka

# ---- Email (optional; when empty, emails are skipped and logged) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Health Care <no-reply@example.com>"

# ---- Uploads / AI (optional) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
OPENROUTER_API_KEY=
